# Copie para .env só se quiser fixar estas variáveis (o docker compose lê o .env sozinho).
# Nunca coloque o .env no git: ele já está no .gitignore e no .dockerignore.

# Senha inicial do admin@petshop.com. Usada só na primeira execução, quando o banco é criado;
# vazia = senha aleatória mostrada uma vez no log ("docker compose logs php | grep 'senha inicial'").
# Depois do primeiro acesso, apague a linha: a senha fica no banco e a troca é obrigatória.
ADMIN_SENHA=

# 1 = mostra erros na tela e cria contas de demonstração (senha123). Só em desenvolvimento.
APP_DEBUG=0

# Senha da cifra (7-Zip, AES-256) dos backups enviados ao OneDrive. Mínimo de 12 caracteres.
# GUARDE UMA CÓPIA fora deste computador (gerenciador de senhas ou papel guardado): sem ela os backups do OneDrive não abrem.
BACKUP_SENHA=
